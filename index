<script>
(function(){
  var rail=document.getElementById('rail');
  document.querySelectorAll('.arrows button').forEach(function(b){
    b.addEventListener('click',function(){
      var w=rail.querySelector('.vcard').offsetWidth+16;
      rail.scrollBy({left:Number(b.dataset.d)*w,behavior:'smooth'});
    });
  });
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    var base=[].slice.call(rail.querySelectorAll('.vcard'));
    for(var i=0;i<5;i++){base.forEach(function(c){var k=c.cloneNode(true);k.classList.add('clone');k.setAttribute('aria-hidden','true');rail.appendChild(k)})}
  }
  rail.querySelectorAll('.vcard').forEach(function(c){
    var v=c.querySelector('video');
    var has=!!(v.getAttribute('src')||v.querySelector('source'));
    if(has)c.classList.add('has-video');
    function setPaused(p){
      c.classList.toggle('paused',p);
      if(has){if(p)v.pause();else{var r=v.play();if(r&&r.catch)r.catch(function(){})}}
    }
    new IntersectionObserver(function(en){
      en.forEach(function(x){
        if(x.isIntersecting){setPaused(false)}
        else{c.classList.add('paused');if(has)v.pause()}
      });
    },{threshold:.6}).observe(c);
  });
})();
</script>
<script>
(function(){
  var rail=document.getElementById('rail'),sec=document.getElementById('reels');
  if(!rail||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  var SPEED=28,pos=rail.scrollLeft,last=0,holdUntil=0,inView=false,hover=false,rewinding=false;
  function max(){return rail.scrollWidth-rail.clientWidth}
  function hold(ms){holdUntil=performance.now()+ms}
  function userTouch(){rail.classList.remove('auto');hold(3500)}
  new IntersectionObserver(function(e){inView=e[0].isIntersecting},{threshold:.2}).observe(sec);
  rail.addEventListener('mouseenter',function(){hover=true});
  rail.addEventListener('mouseleave',function(){hover=false;hold(600)});
  rail.addEventListener('touchstart',userTouch,{passive:true});
  rail.addEventListener('touchend',function(){hold(3500)},{passive:true});
  rail.addEventListener('wheel',userTouch,{passive:true});
  document.querySelectorAll('.arrows button').forEach(function(b){b.addEventListener('click',function(){hold(4500)})});
var n=rail.querySelectorAll('.vcard:not(.clone)').length,W=0,idle;
  function loopW(){var c=rail.querySelectorAll('.vcard');return c[n]?c[n].offsetLeft-c[0].offsetLeft:0}
  function wrap(){var x=rail.scrollLeft;if(!W)return;if(x>=2*W){rail.scrollLeft=x-W;pos-=W}else if(x<W){rail.scrollLeft=x+W;pos+=W}}
  rail.addEventListener('scroll',function(){clearTimeout(idle);idle=setTimeout(wrap,140)},{passive:true});
  window.addEventListener('resize',function(){W=loopW()});
  W=loopW();if(W){rail.scrollLeft=W;pos=W}
  function tick(t){
    var dt=last?Math.min(t-last,64):0;last=t;
    var on=inView&&!document.hidden&&!hover&&!document.fullscreenElement&&!rewinding&&t>holdUntil;
    if(on){
      rail.classList.add('auto');
      if(Math.abs(rail.scrollLeft-pos)>2)pos=rail.scrollLeft;
      pos+=SPEED*dt/1000;
      if(W&&pos>=2*W)pos-=W;
      rail.scrollLeft=pos;
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();
</script>
<script>
(function(){
  var V={
  "showreel":"",
  "reel01":"",
  "loop01":"",
  "pixy":"",
  "skate":"",
  "mainloop":"",
  "main03":"",
  "ark":"",
  "ico":"",
  "m02":"",
  "chucky":"",
  "banana":"",
  "girl":"",
  "punk":"",
  "overthink":"",
  "human":"",
  "totem":""
  };
  var urls={};
  function mk(k){
    if(urls[k])return urls[k];
    try{
      var b=atob(V[k]),u=new Uint8Array(b.length);
      for(var i=0;i<b.length;i++)u[i]=b.charCodeAt(i);
      urls[k]=URL.createObjectURL(new Blob([u],{type:'video/mp4'}));
    }catch(e){urls[k]='data:video/mp4;base64,'+V[k]}
    return urls[k];
  }
  function bind(v,k,ready){
    v.addEventListener('error',function(){if(v.src.indexOf('blob:')===0)v.src='data:video/mp4;base64,'+V[k]},{once:true});
    v.addEventListener('loadeddata',ready);
    v.src=mk(k);
  }
  function play(v){var r=v.play();if(r&&r.catch)r.catch(function(){})}

  /* hero loop + main showreel */
  [['#heroReel',true],['#mainReel',false]].forEach(function(a){
    var box=document.querySelector(a[0]),v=box&&box.querySelector('video');if(!v)return;
    bind(v,'showreel',function(){box.classList.add('has-video');if(a[1])play(v)});
  });

  /* Vertical carousel: bind videos by reel label (original cards + loop clones) */
  var rmap={'Reel 01':'reel01','Reel 02':'ark','Reel 03':'ico','Reel 04':'m02','Reel 05':'girl'};
  [].slice.call(document.querySelectorAll('#rail .vcard')).forEach(function(c){
    var t=c.querySelector('.vtag'),k=t&&rmap[t.textContent.trim()],v=c.querySelector('video');
    if(!k||!v)return;
    function sync(){if(c.classList.contains('paused'))v.pause();else play(v)}
    bind(v,k,function(){c.classList.add('has-video');sync()});
    new MutationObserver(function(){if(v.readyState>=2)sync()}).observe(c,{attributes:true,attributeFilter:['class']});
  });

  /* Works wall tiles: play only while visible */
  var map={'Loop 01':'loop01','Loop 02':'pixy','Loop 03':'skate','Loop 05':'mainloop','Loop 06':'main03','Loop 13':'punk','Loop 14':'banana','Loop 15':'human','Loop 16':'totem'};
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){
      var t=e.target,v=t.querySelector('video');t._vis=e.isIntersecting;
      if(!t.classList.contains('has-video'))return;
      if(e.isIntersecting)play(v);else v.pause();
    });
  },{threshold:.25});
  document.querySelectorAll('.wall .tile').forEach(function(t){
    var l=t.querySelector('.ph2 span'),k=l&&map[l.textContent.trim()],v=t.querySelector('video');
    if(!k||!v)return;
    v.removeAttribute('autoplay');
    bind(v,k,function(){t.classList.add('has-video');if(t._vis)play(v)});
    io.observe(t);
  });
  /* Edit section: reuse the same video data, play only while visible */
  var eio=new IntersectionObserver(function(es){
    es.forEach(function(e){
      var f=e.target,v=f.querySelector('video');f._vis=e.isIntersecting;
      if(!f._ready)return;
      if(e.isIntersecting)play(v);else v.pause();
    });
  },{threshold:.3});
  document.querySelectorAll('.eframe').forEach(function(f){
    var v=f.querySelector('video'),k=f.getAttribute('data-k');
    if(!v||!k)return;
    bind(v,k,function(){f._ready=true;if(f._vis)play(v)});
    eio.observe(f);
  });
  /* Project videos */
  document.querySelectorAll('.shot[data-k]').forEach(function(f){
    var v=f.querySelector('video'),k=f.getAttribute('data-k');
    if(!v||!k)return;
    bind(v,k,function(){f.classList.add('has-video');f._ready=true;if(f._vis)play(v)});
    eio.observe(f);
  });
  document.addEventListener('fullscreenchange',function(){
    if(!document.fullscreenElement)document.querySelectorAll('.eframe video').forEach(function(v){v.controls=false});
  });
  /* Click-to-view lightbox for videos that have no link */
  var lbx=document.createElement('div');lbx.className='lightbox';lbx.setAttribute('role','dialog');lbx.setAttribute('aria-modal','true');
  lbx.innerHTML='<button class="lb-x" type="button" aria-label="Close">&times;</button><video controls loop playsinline></video><div class="lb-bar"><span class="lb-title"></span><a class="lb-btn lb-web">Download web version</a><a class="lb-btn lb-full" target="_blank" rel="noopener" hidden>Download full resolution</a></div>';
  document.body.appendChild(lbx);
  var lv=lbx.querySelector('video'),lt=lbx.querySelector('.lb-title'),ld=lbx.querySelector('.lb-web'),lf=lbx.querySelector('.lb-full');
  /* full-resolution files: add  key:'https://link'  here once the originals are hosted */
  var FULL={};
  function openLb(k,title){
    var u=mk(k);lv.src=u;ld.href=u;
    if(FULL[k]){lf.href=FULL[k];lf.hidden=false}else{lf.hidden=true}
    ld.setAttribute('download',('Gianni_Polli_'+title).replace(/[^\w\-]+/g,'_')+'.mp4');
    lt.textContent=title;lbx.classList.add('open');play(lv);
  }
  function closeLb(){lbx.classList.remove('open');lv.pause();lv.removeAttribute('src');lv.load()}
  lbx.addEventListener('click',function(e){if(e.target===lbx)closeLb()});
  lbx.querySelector('.lb-x').addEventListener('click',closeLb);
  document.addEventListener('keydown',function(e){if(e.key==='Escape')closeLb()});
  function keyOf(el){
    if(el.matches('.eframe,.shot'))return el.getAttribute('data-k');
    var l=el.querySelector('.ph2 span');return l&&map[l.textContent.trim()]||null;
  }
  function titleOf(el){
    var r=el.closest('.erow,.proj');
    if(r){var h=r.querySelector('h3');if(h)return h.textContent.trim()}
    var lab=el.querySelector('.lab span');return lab?lab.textContent.trim():'Video';
  }
  document.querySelectorAll('.tile,.eframe,.shot').forEach(function(el){
    if(el.closest('a[href]'))return;
    var k=keyOf(el);if(!k)return;
    el.classList.add('lb');
    el.addEventListener('click',function(){openLb(k,titleOf(el))});
  });
})();
</script>
<script>
(function(){
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  var items=[].slice.call(document.querySelectorAll('#work .proj'));
  if(!items.length||!('IntersectionObserver' in window))return;
  items.forEach(function(el){el.classList.add('fx')});
  var io=new IntersectionObserver(function(es){
    var n=0;
    es.filter(function(e){return e.isIntersecting}).forEach(function(e){
      e.target.style.transitionDelay=(n*100)+'ms';n++;
      e.target.classList.add('in');io.unobserve(e.target);
    });
  },{threshold:.15,rootMargin:'0px 0px -8% 0px'});
  items.forEach(function(el){io.observe(el)});
})();
</script>
